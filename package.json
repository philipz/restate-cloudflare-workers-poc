{
  "name": "nexus-poc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:test": "wrangler deploy --env test",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "build:tests": "tsc -p test/tsconfig.json && node test/write-dist-package-type.mjs",
    "test": "npm run build:tests && node --import ./test/loader/register.mjs --import ./test/loader/test-setup.mjs --test \"dist/test/**/*.test.js\"",
    "test:race": "npm run build:tests && node --import ./test/loader/register.mjs --import ./test/loader/test-setup.mjs --test \"dist/test/race_counterexample.test.js\"",
    "test:coverage": "npm run build:tests && node --import ./test/loader/register.mjs --import ./test/loader/test-setup.mjs --test --experimental-test-coverage --test-coverage-exclude=\"dist/test/**\" --test-reporter=spec \"dist/test/**/*.test.js\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240405.0",
    "typescript": "^5.4.5",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "@restatedev/restate-sdk-cloudflare-workers": "^1.17.0"
  }
}